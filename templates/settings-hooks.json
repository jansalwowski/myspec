{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-git-branch.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/validate-frontmatter.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/mark-code-changed.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/no-absolute-paths.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/require-reuse-audit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/verify-before-stop.sh"
          }
        ]
      }
    ]
  }
}
