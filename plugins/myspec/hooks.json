{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/guard-worktree-context.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/require-isolation-decision.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/validate-frontmatter.sh"
          },
          {
            "type": "command",
            "command": "./hooks/mark-code-changed.sh"
          },
          {
            "type": "command",
            "command": "./hooks/no-absolute-paths.sh"
          },
          {
            "type": "command",
            "command": "./hooks/require-reuse-audit.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/mark-code-changed.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/verify-before-stop.sh"
          }
        ]
      }
    ]
  }
}
