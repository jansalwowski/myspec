#!/usr/bin/env bash
# pre-commit: static skill lint on staged SKILL.md files (PLUGIN-ROOT-REF on
# other staged skills/ Markdown), `bash -n` and
# ShellCheck on staged hooks/ and lib/ shell scripts, eslint
# (scripts/lint-js.sh) on staged lib/ and workflows/ JS. Nothing runs when none of those is
# staged. When shellcheck is not installed, or eslint cannot run through npx
# (offline, no node), that check is skipped with a notice, not blocked.
#
# What is checked is what gets committed: the index is materialised into a
# temp dir and linted there, so an unstaged edit can neither hide a staged
# defect nor block a clean staged file. The whole index is exported, not only
# the staged files, because relative links and the name/directory check need
# the surrounding tree.
#
# Installed by scripts/install-git-hooks.sh (core.hooksPath=.githooks).
#
# Escape hatch: git commit --no-verify

set -uo pipefail

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0

skills=()
shells=()
jsfiles=()
while IFS= read -r -d '' f; do
  # A non-SKILL.md file under skills/ gets only PLUGIN-ROOT-REF (#313).
  if [[ "$f" =~ ^(\.claude/)?skills/[^/]+/SKILL\.md$ || ( "$f" =~ ^skills/.+\.md$ && ! "$f" =~ /SKILL\.md$ ) ]]; then
    skills+=("$f")
  elif [[ "$f" =~ ^(hooks|lib)/.*\.sh$ ]]; then
    shells+=("$f")
  elif [[ "$f" =~ ^lib/.*\.(mjs|cjs|js)$ || "$f" =~ ^workflows/[^/]+\.js$ ]]; then
    jsfiles+=("$f")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

[ ${#skills[@]} -eq 0 ] && [ ${#shells[@]} -eq 0 ] && [ ${#jsfiles[@]} -eq 0 ] && exit 0

tmp=$(mktemp -d "${TMPDIR:-/tmp}/pre-commit-index.XXXXXX") || { echo "pre-commit: mktemp failed; checks skipped" >&2; exit 0; }
trap 'rm -rf "$tmp"' EXIT
# GIT_INDEX_FILE, when git sets it for `git commit <paths>` or `-a`, is honoured.
if ! git checkout-index -a -f --prefix="$tmp/"; then
  echo "pre-commit: could not export the index; checks skipped" >&2
  exit 0
fi

status=0

for f in ${shells[@]+"${shells[@]}"}; do
  if ! out=$(bash -n "$tmp/$f" 2>&1); then
    printf '%s\n' "${out//$tmp\//}" >&2
    printf 'pre-commit: bash -n failed on %s\n' "$f" >&2
    status=1
  fi
done

if [ ${#shells[@]} -gt 0 ]; then
  # Same entry point as CI (test.yml), which pins the version; here the
  # shellcheck on PATH, or $SHELLCHECK, will do. Run from the export so the
  # staged tests/.shellcheckrc files apply and findings print as repo paths.
  # No working-tree fallback: lint-sh.sh lints relative to its own checkout.
  shlint="$tmp/scripts/lint-sh.sh"
  if ! command -v "${SHELLCHECK:-shellcheck}" >/dev/null 2>&1; then
    echo "pre-commit: shellcheck not found; shell lint skipped" >&2
  elif [ ! -f "$shlint" ]; then
    echo "pre-commit: scripts/lint-sh.sh not found; shell lint skipped" >&2
  else
    # Only the staged scripts are inputs, so a `source` of an unstaged lib
    # would be SC1091 ("not specified as input"), and a variable it reads
    # SC2034 (#308). --external-sources follows each source in the export the
    # way CI's full-tree run does, and still reports findings only in the
    # inputs, so a staged script fails only where CI would. A full-tree run
    # filtered to the staged files would match too, but takes ~20s a commit.
    # Any non-zero exit blocks: ShellCheck exits 2 when one file cannot be
    # read but still reports findings in the rest.
    if ! (cd "$tmp" && SHELLCHECK_OPTS="--external-sources${SHELLCHECK_OPTS:+ $SHELLCHECK_OPTS}" bash "$shlint" "${shells[@]}") >&2; then
      echo "pre-commit: shellcheck failed on staged shell scripts" >&2
      status=1
    fi
  fi
fi

if [ ${#skills[@]} -gt 0 ]; then
  # Prefer the staged linter; fall back to the working tree's when it is not tracked.
  linter="$tmp/scripts/lint-skills.mjs"
  [ -f "$linter" ] || linter="$root/scripts/lint-skills.mjs"
  if ! command -v node >/dev/null 2>&1; then
    echo "pre-commit: node not found; skill lint skipped" >&2
  elif [ ! -f "$linter" ]; then
    echo "pre-commit: scripts/lint-skills.mjs not found; skill lint skipped" >&2
  else
    # Run from the export with repo-relative paths, so findings print as repo paths.
    (cd "$tmp" && node "$linter" --root "$tmp" --files "${skills[@]}")
    rc=$?
    if [ "$rc" -ne 0 ]; then
      [ "$rc" -eq 1 ] || echo "pre-commit: lint-skills exited $rc (usage or internal error)" >&2
      status=1
    fi
  fi
fi

if [ ${#jsfiles[@]} -gt 0 ]; then
  # Prefer the staged script and config; fall back to the working tree's.
  jslint="$tmp/scripts/lint-js.sh"
  [ -f "$jslint" ] || jslint="$root/scripts/lint-js.sh"
  # eslint prints absolute paths, resolved through symlinks ($TMPDIR on macOS).
  rtmp=$(cd "$tmp" && pwd -P)
  if [ ! -f "$jslint" ]; then
    echo "pre-commit: scripts/lint-js.sh not found; JS lint skipped" >&2
  elif ! command -v npx >/dev/null 2>&1; then
    echo "pre-commit: npx not found; JS lint skipped" >&2
  elif ! (cd "$rtmp" && bash "$jslint" --version) >/dev/null 2>&1; then
    echo "pre-commit: eslint could not run (offline?); JS lint skipped" >&2
  else
    out=$(cd "$rtmp" && bash "$jslint" "${jsfiles[@]}" 2>&1)
    rc=$?
    out=${out//$rtmp\//}
    out=${out//$tmp\//}
    if [ "$rc" -eq 1 ]; then
      printf '%s\n' "$out" >&2
      status=1
    elif [ "$rc" -ne 0 ]; then
      printf '%s\n' "$out" >&2
      echo "pre-commit: eslint exited $rc (config or internal error); JS lint skipped" >&2
    fi
  fi
fi

if [ "$status" -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: commit blocked (checked the staged content). Fix the findings above, or bypass once with: git commit --no-verify" >&2
fi
exit $status
